<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jarvis Kamera</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0a0a0a;
      color: #f5f5f5;
      font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 20px;
    }
    h1 { font-size: 28px; margin-bottom: 16px; }
    video { width: 100%; border-radius: 16px; background: #000; }
    input {
      width: 100%; margin-top: 12px; background: #151515;
      border: 1px solid #2a2a2a; border-radius: 14px;
      color: #f5f5f5; font-size: 18px; padding: 14px; outline: none;
    }
    button {
      margin-top: 14px; background: #fff; color: #0a0a0a; border: none;
      border-radius: 14px; font-size: 18px; font-weight: 600;
      padding: 14px 24px; cursor: pointer;
    }
    button:disabled { opacity: 0.5; }
    #antwort {
      margin-top: 20px; padding: 16px; border-radius: 14px;
      background: #151515; border: 1px solid #2a2a2a;
      font-size: 17px; white-space: pre-wrap; display: none;
    }
  </style>
</head>
<body>
  <h1>Jarvis Kamera</h1>
  <video id="video" autoplay playsinline muted></video>
  <canvas id="canvas" style="display:none;"></canvas>
  <input id="frage" type="text" placeholder="Optional: Frage, z.B. Wie repariere ich das?" autocomplete="off">
  <input id="passwort" type="password" placeholder="Dein Kamera-Passwort" autocomplete="off">
  <button id="knopf" onclick="beschreiben()">Beschreiben</button>
  <div id="antwort"></div>

  <script>
    var WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbwkOro3WvAqZCibXHB5i5EDJXigglV-6Tb1gjvK6b9c-0-Io8UzEZexjl1KFUI64Q-2/exec';

    var video = document.getElementById('video');
    var antwort = document.getElementById('antwort');

    function zeigen(text) {
      antwort.style.display = 'block';
      antwort.textContent = text;
    }

    navigator.mediaDevices.getUserMedia({ video: true })
      .then(function(stream) { video.srcObject = stream; })
      .catch(function(fehler) { zeigen('Kamera nicht erreichbar: ' + fehler.message); });

    function beschreiben() {
      var passwort = document.getElementById('passwort').value;
      if (!passwort) { zeigen('Bitte zuerst das Passwort eingeben.'); return; }

      var canvas = document.getElementById('canvas');
      canvas.width = 640;
      canvas.height = Math.round(640 * video.videoHeight / video.videoWidth) || 480;
      canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
      var bild = canvas.toDataURL('image/jpeg', 0.8).split(',')[1];

      var knopf = document.getElementById('knopf');
      knopf.disabled = true;
      zeigen('Moment ...');

      fetch(WEB_APP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          passwort: passwort,
          bild: bild,
          frage: document.getElementById('frage').value
        })
      })
      .then(function(antwortObjekt) { return antwortObjekt.json(); })
      .then(function(daten) { zeigen(daten.text); knopf.disabled = false; })
      .catch(function(fehler) { zeigen('Fehler: ' + fehler.message); knopf.disabled = false; });
    }
  </script>
</body>
</html>